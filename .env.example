# Copiar a .env y completar con valores propios antes de levantar el stack:
#   cp .env.example .env
#
# Los TRES secretos reales (password de la DB, signing secret y master key)
# NO van acá: docker-compose.yml los lee de archivos en secrets/ (Docker
# secrets), para que nunca queden en texto plano en `docker inspect` ni en
# `docker compose config`. Generarlos con:
#   ./scripts/generate-secrets.sh
# Este .env sólo tiene configuración no sensible (usuarios, límites, CORS).

# --- Base de datos ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=storage
DB_NAME=storage
DB_SSLMODE=disable

# --- Almacenamiento ---
# Ruta DENTRO del contenedor donde se guardan los archivos (el volumen
# "storage_data" de docker-compose la persiste en el host).
STORAGE_PATH=/data/storage
MAX_FILE_SIZE_MB=500

# --- Servidor ---
API_PORT=8080
# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Para un frontend Next.js en Vercel, usar el/los dominio(s) reales, ej:
#   CORS_ORIGIN=https://mi-app.vercel.app,https://mi-dominio.com
# "*" permite cualquier origen (sólo recomendado en desarrollo).
CORS_ORIGIN=*
ENVIRONMENT=production

# --- Seguridad ---
# Minutos de validez de los links de descarga presignados.
TOKEN_EXPIRY_MINUTES=15

# --- Rate limiting ---
# General, aplica a toda /api/* (protección anti-abuso base). Clave por
# user_id de la API key si la request está autenticada, o por IP si no.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
# Adicional y más estricto, sólo para /api/upload/:bucket.
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
